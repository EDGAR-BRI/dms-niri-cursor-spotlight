{
    "id": "cursorSpotlight",
    "name": "Cursor Spotlight, Clicks & Draw",
    "description": "Screen blur spotlight to locate the cursor, animated click ripples, and on-screen drawing brush for Niri + DMS",
    "version": "1.1.0",
    "license": "MIT",
    "author": "EDGAR-BRI",
    "icon": "my_location",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "ipc"
    ],
    "components": {
        "daemon": "./CursorSpotlight.qml",
        "widget": "./CursorSpotlightWidget.qml"
    },
    "settings": "./CursorSpotlightSettings.qml",
    "requires_dms": ">=1.5.0",
    "dependencies": [
        "python3"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "shell_execute"
    ]
}
